<?xml version="1.0" encoding="UTF-8"?>
<LightningComponentBundle xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>67.0</apiVersion>
    <isExposed>true</isExposed>
    <masterLabel>Caso Lista (Seletor de Contas)</masterLabel>
    <description>Lista os Chamados da Account ativa no Account Switcher, assinando o AccountContextChannel. O AccountId é sempre revalidado no Apex.</description>
    <targets>
        <target>lightningCommunity__Default</target>
        <target>lightningCommunity__Page</target>
    </targets>
    <targetConfigs>
        <targetConfig targets="lightningCommunity__Default">
            <property name="compact" type="Boolean" label="Modo compacto (widget da Início)" default="false" />
            <property name="maxRows" type="Integer" label="Máximo de linhas (modo compacto)" />
            <property name="initialView" type="String" label="Modo de exibição inicial" />
        </targetConfig>
    </targetConfigs>
</LightningComponentBundle>
